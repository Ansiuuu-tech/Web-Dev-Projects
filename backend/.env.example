# ─── Server ───────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB ──────────────────────────────
# Local:
MONGO_URI=mongodb+srv://donateease:Gaurji%40123@donateease.copnjx5.mongodb.net/donateease?retryWrites=true&w=majority
# Atlas (production):
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/donateease?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_64chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another_long_random_secret_for_refresh
JWT_REFRESH_EXPIRES_IN=30d

# ─── Razorpay ─────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=webhook_secret_here

# ─── Twilio (SMS OTP) ─────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# ─── Email (SMTP) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=DonateEase <noreply@donateease.in>

# ─── Cloudinary (File Uploads) ───────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
